# Generated by audit-gen --format=splunk-ta — DO NOT EDIT by hand.
# Export the eventtypes and tags app-wide so dashboards in other
# apps can use them.
#
# The global [] stanza declares the default ACL for every knowledge
# object in this TA: world-readable, admin-writable. Splunkbase's
# check_meta_default_write_access rule fails the publish if no
# global write access is declared.

[]
# Include sc_admin alongside admin so the TA is usable on Splunk
# Cloud, where customers do not have the admin role.
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[eventtypes]
export = system

[tags]
export = system

[props]
export = system
